{
  "App": {
    "ClientsFilePath": "data/clients.json"
  },
  "Mqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "Username": "",
    "Password": "",
    "BaseTopic": "powercontroller"
  },
  "Relay": {
    "Relays": [
      {
        "Id": 1,
        "GpioPin": 17,
        "ActiveLow": true,
        "Description": "Main power relay"
      }
    ]
  },
  "Shutdown": {
    "ClientAckTimeoutSeconds": 30,
    "StatusPollIntervalSeconds": 5,
    "MaxShutdownWaitSeconds": 300,
    "PingFailureThreshold": 3,
    "RelayHoldDurationMs": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
